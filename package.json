{
  "name": "zju-control-llm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/mcp/*.test.js dist/test/agent/*.test.js dist/test/experiment/*.test.js dist/test/generation/*.test.js",
    "test:agent": "npm run build && node --test dist/test/agent/*.test.js",
    "test:mcp": "npm run build && node --test dist/test/mcp/*.test.js",
    "experiment": "npm run build && node dist/src/experiment/stage2a.js",
    "experiment:report": "npm run build && node dist/src/experiment/stage2a.js report",
    "experiment:stage2b": "npm run build && node dist/src/experiment/stage2b.js",
    "generation": "npm run build && node dist/src/generation/main.js",
    "start": "node dist/src/mcp/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "openai": "7.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
